[sub_resource type="Shader" id="Shader_shadow"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never;

void fragment() {
	vec2 centered = (UV - vec2(0.5)) * vec2(2.0, 2.0);
	float ellipse = dot(centered * vec2(0.72, 1.0), centered * vec2(0.72, 1.0));
	float alpha = (1.0 - smoothstep(0.16, 1.0, ellipse)) * 0.28;
	ALBEDO = vec3(0.0);
	ALPHA = alpha;
}
"

